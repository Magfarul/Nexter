{
  "name": "Nexter",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "watch": "node-sass sass/main.scss css/style.css --watch",
    "deServer": "live-server",
    "start": "npm-run-all --parallel deServer watch",
    "compile": "node-sass sass/main.scss css/style.comp.css",
    "prefix": "postcss --use autoprefixer -b 'last 10 versions' css/style.comp.css -o css/style.prefix.css",
    "compress": "node-sass css/style.prefix.css css/style.css --output-style compressed ",
    "build": "npm-run-all compile prefix compress"
  },
  "author": "Magfarul",
  "license": "ISC",
  "devDependencies": {
    "concat": "^1.0.3",
    "node-sass": "^9.0.0"
  },
  "dependencies": {
    "aos": "^2.3.4",
    "autoprefixer": "^10.4.14",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.24",
    "postcss-cli": "^10.1.0"
  }
}
